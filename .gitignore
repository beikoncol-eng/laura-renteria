# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# testing
/coverage

# sanity
/dist
sanity/dist

# misc
.DS_Store
*.pem
Thumbs.db

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env
.env*.local
.env.development
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo

# editor
.idea
*.swp

# raw source media — kept out of git (large originals). Optimized, committed
# web derivatives live in /public/assets/images/web. Archive the raw originals
# and raw videos OUT of the deploy bundle before shipping (see ASSET_MAP.md).
/public/assets/images/*.JPG
/public/assets/images/*.jpeg
/public/assets/video/*.mp4
/public/assets/videos/*.mp4

# local media source archive (if used)
/media-source/
